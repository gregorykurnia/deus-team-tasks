rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /flows/{flowId} {
      allow read, write: if true;
    }
    match /taskGroups/{groupId} {
      allow read, write: if true;
    }
    // Shared settings: the next company id, and the company options and fields (task 1.7).
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
