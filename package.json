{
  "name": "deus-team-tasks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:smoke": "playwright test",
    "a11y": "node scripts/a11y/axe.mjs --servers --distinct",
    "compare": "JAVA_TOOL_OPTIONS=-Xmx2g node scripts/compare/run.mjs --servers",
    "test:unit": "vitest run --project unit",
    "launch-data": "jiti scripts/launch/data.ts",
    "launch-data:dry": "scripts/launch/dry-run.sh",
    "test:data": "firebase emulators:exec --only firestore,auth --project demo-deus --log-verbosity QUIET \"vitest run --project data\"",
    "people:add": "node scripts/people.mjs add",
    "people:remove": "node scripts/people.mjs remove",
    "leave:setup": "node scripts/leave-setup.mjs",
    "notify:keys": "node scripts/notify-keys.mjs",
    "mcp:smoke": "node scripts/mcp/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.1",
    "googleapis": "^176.0.0",
    "mcp-handler": "1.1.0",
    "next": "16.3.1",
    "nodemailer": "^10.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^15.34.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "firebase-admin": {
      "jwks-rsa": "3.2.2"
    }
  }
}
