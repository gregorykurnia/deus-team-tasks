{
  "name": "deus-team-tasks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:smoke": "playwright test",
    "a11y": "node scripts/a11y/axe.mjs --servers --distinct",
    "compare": "JAVA_TOOL_OPTIONS=-Xmx2g node scripts/compare/run.mjs --servers",
    "test:unit": "vitest run --project unit",
    "launch-data": "jiti scripts/launch/data.ts",
    "launch-data:dry": "scripts/launch/dry-run.sh",
    "test:data": "firebase emulators:exec --only firestore --project demo-deus --log-verbosity QUIET \"vitest run --project data\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "googleapis": "^176.0.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^15.34.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
