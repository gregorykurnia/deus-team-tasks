{
  "terminal.integrated.profiles.linux": {
    "tmux": {
      "path": "tmux",
      "args": [
        "new-session",
        "-A",
        "-s",
        "deus"
      ],
      "icon": "terminal-tmux"
    },
    "studio": {
      "path": "tmux",
      "args": [
        "-L",
        "studio",
        "new-session",
        "-A",
        "-s",
        "studio",
        "-c",
        "/home/ubuntu/deus-team-tasks-studio"
      ],
      "icon": "paintcan"
    }
  }
}
